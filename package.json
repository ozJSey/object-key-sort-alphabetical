{
  "name": "object-sort-alphabetical",
  "displayName": "Object Sort Alphabetical",
  "description": "Automatically sort object properties alphabetically on save",
  "version": "0.9.0",
  "publisher": "ozJSey",
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ozJSey/object-key-sort-alphabetical.git"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Object Sort Alphabetical",
      "properties": {
        "objectSortAlphabetical.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic sorting of object properties on save"
        },
        "objectSortAlphabetical.sortOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Sort objects when file is saved"
        },
        "objectSortAlphabetical.sortImports": {
          "type": "boolean",
          "default": true,
          "description": "Sort named imports alphabetically"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.x",
    "typescript": "^5.3.0"
  }
}
