{
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:vue",
    "onLanguage:json",
    "onLanguage:jsonc"
  ],
  "categories": [
    "Formatters"
  ],
  "contributes": {
    "commands": [
      {
        "command": "objectSortAlphabetical.saveWithoutSorting",
        "title": "File: Save without sorting",
        "category": "Object Sort Alphabetical"
      }
    ],
    "configuration": {
      "properties": {
        "objectSortAlphabetical.enabled": {
          "default": true,
          "description": "Enable automatic sorting of object properties on save",
          "type": "boolean"
        },
        "objectSortAlphabetical.sortOnSave": {
          "default": true,
          "description": "Sort objects when file is saved",
          "type": "boolean"
        },
        "objectSortAlphabetical.sortOrder": {
          "default": "asc",
          "description": "Sort order for object keys",
          "enum": ["asc", "desc"],
          "enumDescriptions": [
            "Ascending (A to Z)",
            "Descending (Z to A)"
          ],
          "type": "string"
        },
        "objectSortAlphabetical.caseSensitive": {
          "default": false,
          "description": "Use case-sensitive sorting",
          "type": "boolean"
        },
        "objectSortAlphabetical.priorityKeys": {
          "default": ["id", "_id", "constructor"],
          "description": "Keys that should always appear first (in order). Use prefix patterns like '__*' for all keys starting with '__'",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "objectSortAlphabetical.supportedLanguages": {
          "default": ["javascript", "typescript", "javascriptreact", "typescriptreact", "vue", "json", "jsonc"],
          "description": "Language IDs where sorting should be applied",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "objectSortAlphabetical.excludePatterns": {
          "default": [],
          "description": "Glob patterns for files to exclude from sorting",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "objectSortAlphabetical.sortImports": {
          "default": true,
          "description": "Sort named imports alphabetically",
          "type": "boolean"
        }
      },
      "title": "Object Sort Alphabetical"
    }
  },
  "description": "Automatically sort object properties alphabetically on save",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.x",
    "@types/vscode": "^1.0.0",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.x",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.3.0"
  },
  "displayName": "Object Sort Alphabetical",
  "engines": {
    "vscode": "^1.0.0"
  },
  "icon": "assets/icon.png",
  "main": "./out/extension.js",
  "name": "object-sort-alphabetical",
  "publisher": "ozJSey",
  "repository": {
    "type": "git",
    "url": "https://github.com/ozJSey/object-key-sort-alphabetical.git"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "pretest": "npm run compile",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "vscode:prepublish": "npm run compile",
    "watch": "tsc -watch -p ./"
  },
  "version": "1.5.0"
}
