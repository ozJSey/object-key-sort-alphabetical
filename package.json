{
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Formatters"
  ],
  "contributes": {
    "configuration": {
      "properties": {
        "objectSortAlphabetical.enabled": {
          "default": true,
          "description": "Enable automatic sorting of object properties on save",
          "type": "boolean"
        },
        "objectSortAlphabetical.sortImports": {
          "default": true,
          "description": "Sort named imports alphabetically",
          "type": "boolean"
        },
        "objectSortAlphabetical.sortOnSave": {
          "default": true,
          "description": "Sort objects when file is saved",
          "type": "boolean"
        }
      },
      "title": "Object Sort Alphabetical"
    }
  },
  "description": "Automatically sort object properties alphabetically on save",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.x",
    "@types/vscode": "^1.0.0",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.x",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.3.0"
  },
  "displayName": "Object Sort Alphabetical",
  "engines": {
    "vscode": "^1.0.0"
  },
  "icon": "assets/icon.png",
  "main": "./out/extension.js",
  "name": "object-sort-alphabetical",
  "publisher": "ozJSey",
  "repository": {
    "type": "git",
    "url": "https://github.com/ozJSey/object-key-sort-alphabetical.git"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "pretest": "npm run compile",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "vscode:prepublish": "npm run compile",
    "watch": "tsc -watch -p ./"
  },
  "version": "1.3.5"
}
